# Provider API keys, only needed to regenerate raw chain-of-thought traces with the
# cloud calibration models (scripts/run_api_generation.py). They are NOT required to
# reproduce the paper's tables and figures from the shipped data.
#
# Copy this file to `.env` and fill in the providers you actually use.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
TOGETHER_API_KEY=
OPENROUTER_API_KEY=
